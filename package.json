{
  "name": "@fluentez/monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "description": "Ecosystem of modular libraries for modern web application development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fluentez/fluentez-packages.git"
  },
  "homepage": "https://fluentez.github.io/fluentez-packages/",
  "bugs": {
    "url": "https://github.com/Fluentez/fluentez-packages/issues"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json,md}\"",
    "test": "bun test",
    "clean": "rimraf packages/*/dist"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "bun-types": "^1.3.14",
    "happy-dom": "^17.1.8",
    "oxlint": "^0.15.0",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

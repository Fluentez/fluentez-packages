{
  "name": "@fluentez/monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "description": "Ecosystem of modular libraries for modern web application development",
  "scripts": {
    "build": "npm run build --workspaces",
    "check-types": "npm run check-types --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "clean": "rimraf packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "oxlint": "^0.15.0",
    "typescript": "^5.3.3",
    "tsup": "^8.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}

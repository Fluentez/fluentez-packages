{
  "name": "@fluentez/monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "description": "Ecosystem of modular libraries for modern web application development",
  "scripts": {
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "test": "bun test",
    "clean": "rimraf packages/*/dist"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "bun-types": "^1.3.14",
    "oxlint": "^0.15.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
